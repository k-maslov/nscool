# Machine-specific settings for `make plug`, read by the makefile if present
# as src/makefile.local (untracked).
#
# In the joint_eos repo this file is GENERATED by ../../get_o2scl.sh, which
# builds o2scl into a local prefix and fills in the paths it found. The values
# below are what it produced on a Mac with Apple silicon (Homebrew packages);
# copy and edit them only if you build o2scl some other way.
O2SCL = /path/to/joint_eos/build/o2scl
LCXX = clang++
LFC = gfortran
LCFLAGS = -std=c++17 -O3 -I$(O2SCL)/include \
	-I/opt/homebrew/opt/hdf5/include -I/opt/homebrew/opt/gsl/include \
	-I/opt/homebrew/opt/boost/include -I/opt/homebrew/opt/readline/include \
	-DNO_MPI -DNO_OPENMP -DO2SCL_NO_BOOST_MULTIPRECISION \
	-Wno-deprecated-declarations
LFFLAGS = -O3
LIBS = -L$(O2SCL)/lib -Wl,-rpath,$(O2SCL)/lib \
	-L/opt/homebrew/opt/hdf5/lib -L/opt/homebrew/opt/gsl/lib \
	-L/opt/homebrew/opt/readline/lib \
	-lo2scl -lhdf5 -lhdf5_hl -lgsl -lgslcblas -lreadline
# On Linux with the Debian/Ubuntu HDF5 layout use -lhdf5_serial -lhdf5_serial_hl;
# with a plain hdf5.h (cluster modules) add -DO2SCL_PLAIN_HDF5_HEADER to LCFLAGS.
FLIBS = -L/opt/homebrew/opt/gcc/lib/gcc/current -lgfortran -lquadmath
